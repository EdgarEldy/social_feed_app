API_BASE_URL=https://api.example.com
API_TIMEOUT_SECONDS=10

# Flavors
#
# lib/main_development.dart and lib/main_production.dart load
# .env.development and .env.production respectively instead of this file.
# Neither is committed (see .gitignore), so copy this file to each one and
# fill in the values for that flavor, the same way you would for .env:
#
#   cp .env.example .env.development
#   cp .env.example .env.production
#
# A typical development file points at a local/staging API:
#   API_BASE_URL=http://localhost:3000
#   API_TIMEOUT_SECONDS=10
#
# A typical production file points at the live API:
#   API_BASE_URL=https://api.socialfeedapp.com
#   API_TIMEOUT_SECONDS=10
